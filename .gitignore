# uipath-cloud-migration artifacts — operator-local, never commit.
# These contain full tenant inventories. Secrets are never written to them
# (credentials come from environment variables at runtime), but the
# inventories themselves are sensitive.

.local/
migration.local.json
*.local.json
*discovery*.json
source.json
target.json
*migration-plan*.json
*analysis*.xlsx
*analysis*.html
*apply*.json
*apply*.xlsx
*stage-report*.json
DownloadedPackages/
.migration-state/
probe-result.json
*.nupkg
*.log

# Secrets and local environment
.env
.env.*

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Node/build output
node_modules/
dist/
build/

# OS
Thumbs.db
Desktop.ini
.DS_Store
