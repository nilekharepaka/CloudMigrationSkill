{
  "auto_apply_external_storage_buckets": false,
  "auto_import_users": false,
  "batch_size": 1000,
  "apply_batch_size": 10,
  "continue_on_apply_error": true,
  "continue_on_entity_error": true,
  "continue_on_folder_error": true,
  "continue_on_library_error": true,
  "continue_on_package_error": true,
  "credential_asset_password_mode": "dummy",
  "credential_store_key_map": {
    "<source-credential-store-name>": "<target-credential-store-key-guid>"
  },
  "dummy_credential_password": "DummyPassword",
  "artifact_dir": ".migration-state",
  "entities": [
    "folders",
    "credential_stores",
    "roles",
    "users",
    "machines",
    "robots",
    "environments",
    "assets",
    "queues",
    "storage_buckets",
    "packages",
    "libraries",
    "processes",
    "calendars",
    "triggers",
    "webhooks",
    "feeds",
    "settings",
    "bucket_files",
    "queue_items"
  ],
  "library_feed_id": "",
  "package_feed_id": "",
  "package_staging_folder": "DownloadedPackages",
  "queue_item_batch_size": 10,
  "request_interval_ms": 250,
  "source": {
    "auth_mode": "direct_rest",
    "client_id_env": "UIP_ONPREM_CLIENT_ID",
    "client_secret_env": "UIP_ONPREM_CLIENT_SECRET",
    "folder_paths": [],
    "identity_url": "https://<onprem-host>/identity",
    "orchestrator_url": "https://<onprem-host>",
    "scope": "OR.Folders OR.Assets OR.Queues OR.Execution OR.Settings OR.Administration OR.Jobs OR.Users OR.Robots OR.Machines OR.Webhooks OR.License",
    "tenant": "<source-onprem-tenant>",
    "uip_extra_args": []
  },
  "target": {
    "authority": "https://cloud.uipath.com",
    "organization": "<target-cloud-organization>",
    "tenant": "<target-cloud-tenant>",
    "uip_profile": "",
    "folder_paths": [],
    "uip_extra_args": []
  },
  "target_credential_store_key": "<target-credential-store-key-guid>",
  "webhook_dummy_secret": "RotateThisWebhookSecret"
}
